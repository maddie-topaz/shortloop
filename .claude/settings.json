{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm test *)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm run typecheck*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr view*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "ask": [
      "Bash(pulumi up*)",
      "Bash(pulumi refresh*)",
      "Bash(gh pr merge*)",
      "Bash(docker push*)",
      "Bash(aws ecs update-service*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(pulumi destroy*)",
      "Bash(aws iam *)",
      "Bash(gh secret set*)",
      "Bash(gh api -X DELETE*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
